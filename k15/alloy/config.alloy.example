// Grafana Alloy - K15 log shipper.  (docs/observability-design.md, phase E2)
//
// Copy to the install dir and restart the service:
//   copy k15\alloy\config.alloy.example "%PROGRAMFILES%\GrafanaLabs\Alloy\config.alloy"
//   Restart-Service Alloy
//
// Then set the two secrets ONCE as machine environment variables (they are not
// in this file and must never be committed - same posture as secrets.json):
//   [Environment]::SetEnvironmentVariable('GC_LOKI_USER','<instance id>','Machine')
//   [Environment]::SetEnvironmentVariable('GC_LOKI_TOKEN','<token>','Machine')
// Both come from the Grafana Cloud stack's Loki "Details" page. Restart the
// service after setting them - a Windows service reads its environment at start.
//
// WHAT THIS SHIPS: only the daily event stream. couch.log is deliberately NOT
// tailed - it is the human mirror of the same events, and shipping both would
// double the volume to say the same thing twice. Note the glob is k15-*.jsonl,
// so blind-suite runs (which write test-*.jsonl) never leave the machine at all.

// OFF, and it should stay off. Two claims were made for it during bring-up
// and both were wrong: it does not cost CPU (4.44% of one core before,
// 4.53% after - no effect), and it did not help diagnose anything. The
// component pages at http://localhost:12345 - Arguments, Exports, health -
// work WITHOUT it; they are what showed file_match's resolved target. This
// feature streams data through a component and is not even implemented for
// the ones used here ("Live debugging is not yet available for this
// component"). What actually solved the E2 outage was the Windows
// Application event log, which carried the 401 all along.
livedebugging { enabled = false }

local.file_match "events" {
	path_targets = [{
		// EDIT THIS. Do not guess the path - print it on the K15 with:
		//   cd %USERPROFILE%\Desktop\slopstation\k15
		//   python -c "import events; print(events.LOG_DIR)"
		// then write it here with FORWARD slashes.
		__path__ = "C:/Users/minipc/Desktop/slopstation/k15/logs/k15-*.jsonl",
	}]
	// The file rolls over at midnight (local date in the NAME, UTC inside)
	// and events.py moves anything older than two days into logs/archive/,
	// which this glob does not match. That move is a cost control, not
	// tidiness: a tailed file costs ~0.04% of a core whether or not it can
	// still change, and only today's file is ever appended to - so without it
	// this glob grew to 14 tailers, 13 of them watching finished files. See
	// the cost note in gaming-pc/alloy/config.alloy.example for the
	// measurement, and for why the obvious way to measure it reads zero.
	//
	// A move CAN pull a file out from under an open handle now. That is safe:
	// Windows allows the rename and the handle follows the file, so anything
	// half-read still gets read to EOF. Two days is the margin for Alloy
	// having been down.
	sync_period = "30s"
}

loki.source.file "events" {
	targets    = local.file_match.events.targets
	forward_to = [loki.process.events.receiver]
}

loki.process "events" {
	// Lift ONLY the four low-cardinality fields into labels. turn, session,
	// appid, score and friends stay inside the line: they are what you filter
	// by after selecting a stream (`| json | turn="9f2c1a"`), and promoting an
	// id to a label would mint a new stream per launch and blow the index.
	stage.json {
		expressions = {
			level   = "level",
			lane    = "lane",
			env     = "env",
			service = "service",
			ts      = "ts",
		}
	}

	stage.labels {
		values = {
			level   = "",
			lane    = "",
			env     = "",
			service = "",
		}
	}

	// Use the event's own UTC timestamp, not the moment Alloy read the file.
	// Without this, a shipper that was down for an hour backfills everything
	// stamped "now" and the launch you are trying to reconstruct loses its
	// ordering.
	stage.timestamp {
		source = "ts"
		format = "RFC3339"
	}

	forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
	endpoint {
		// This rig's real value (Cloud portal -> Stacks -> Details -> Loki ->
		// Details). US West / prod-us-west-0. The /loki/api/v1/push suffix is
		// NOT shown on that page - it lists the datasource base URL only.
		url = "https://logs-prod-021.grafana.net/loki/api/v1/push"

		basic_auth {
			username = sys.env("GC_LOKI_USER")   // instance id: 1730320
			password = sys.env("GC_LOKI_TOKEN")
		}
	}
	// A dead uplink costs telemetry and nothing else: Alloy retries on its
	// own, and nothing in the voice or chord lane ever waits on it.
}
