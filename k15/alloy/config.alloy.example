// Grafana Alloy - K15 log shipper. Read by the grafana-logs skill
// (.claude/skills/grafana-logs/), which documents the label set below.
//
// Copy to the install dir and restart the service:
//   copy k15\alloy\config.alloy.example "%PROGRAMFILES%\GrafanaLabs\Alloy\config.alloy"
//   Restart-Service Alloy
//
// Then set the two secrets ONCE as machine environment variables (never
// committed):
//   [Environment]::SetEnvironmentVariable('GC_LOKI_USER','<instance id>','Machine')
//   [Environment]::SetEnvironmentVariable('GC_LOKI_TOKEN','<token>','Machine')
// Both from the stack's Loki "Details" page. Restart the service afterwards -
// a Windows service reads its environment at start.
//
// Ships only the daily event stream (couch.log is the human mirror of the same
// events). The glob is k15-*.jsonl, so blind-suite runs writing test-*.jsonl
// never leave the machine.
//
// When shipping stops silently, the Windows Application event log is where
// Alloy says why - it carried the E2 401 all along.

// OFF: measured no CPU effect (4.44% of one core before, 4.53% after) and
// "Live debugging is not yet available" for the components used here. The
// component pages at http://localhost:12345 work without it.
livedebugging { enabled = false }

local.file_match "events" {
	path_targets = [{
		// EDIT THIS. Do not guess the path - print it on the K15 with:
		//   cd %USERPROFILE%\Desktop\slopstation\k15
		//   python -c "import events; print(events.LOG_DIR)"
		// then write it here with FORWARD slashes.
		__path__ = "C:/Users/minipc/Desktop/slopstation/k15/logs/k15-*.jsonl",
	}]
	// The file rolls over at midnight (local date in the NAME, UTC inside)
	// and events.py moves anything older than two days into logs/archive/,
	// which this glob does not match. Cost control: a tailed file costs ~0.04%
	// of a core whether or not it can still change, and only today's file is
	// ever appended to (measurement in gaming-pc/alloy/config.alloy.example).
	//
	// A move can pull a file out from under an open handle; that is safe on
	// Windows - the rename succeeds and the handle follows, so a half-read file
	// still reaches EOF. Two days is the margin for Alloy having been down.
	sync_period = "30s"
}

loki.source.file "events" {
	targets    = local.file_match.events.targets
	forward_to = [loki.process.events.receiver]
}

loki.process "events" {
	// Lift ONLY the four low-cardinality fields into labels. turn, session,
	// appid, score and friends stay inside the line and are filtered after
	// selecting a stream (`| json | turn="9f2c1a"`); promoting an id to a label
	// would mint a new stream per launch and blow the index.
	stage.json {
		expressions = {
			level   = "level",
			lane    = "lane",
			env     = "env",
			service = "service",
			ts      = "ts",
		}
	}

	stage.labels {
		values = {
			level   = "",
			lane    = "",
			env     = "",
			service = "",
		}
	}

	// Use the event's own UTC timestamp, not the moment Alloy read the file:
	// a shipper that was down would otherwise backfill everything stamped
	// "now" and lose the ordering.
	stage.timestamp {
		source = "ts"
		format = "RFC3339"
	}

	forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
	endpoint {
		// This rig's real value (Cloud portal -> Stacks -> Details -> Loki ->
		// Details). US West / prod-us-west-0. The /loki/api/v1/push suffix is
		// NOT shown on that page - it lists the datasource base URL only.
		url = "https://logs-prod-021.grafana.net/loki/api/v1/push"

		basic_auth {
			username = sys.env("GC_LOKI_USER")   // instance id: 1730320
			password = sys.env("GC_LOKI_TOKEN")
		}
	}
	// A dead uplink costs telemetry and nothing else: Alloy retries, and
	// nothing in the voice or chord lane waits on it.
}
