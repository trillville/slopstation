# Copy to .env. Forward slashes keep Windows drive paths valid in Compose.
MEDIA_ROOT=C:/Media
MEDIA_CONFIG_ROOT=C:/ProgramData/Slopstation/media
TZ=America/Los_Angeles
PUID=1000
PGID=1000
# Homarr's at-rest key for its stored integration credentials. Leave empty:
# Start-Media.ps1 fills in 64 hex chars on first run. Never regenerate over a
# populated value; back it up with MEDIA_CONFIG_ROOT.
SECRET_ENCRYPTION_KEY=
