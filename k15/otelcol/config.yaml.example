# OpenTelemetry Collector (contrib) - K15 log shipper. Reads the same daily
# JSONL events.py writes and pushes them to Sentry Logs over OTLP.
#
# CONTRIB, not core: core has no filelog receiver. Grab
# otelcol-contrib_<ver>_windows_x64.msi from
# open-telemetry/opentelemetry-collector-releases; it registers the service.
#
#   copy k15\otelcol\config.yaml.example C:\ProgramData\otelcol-contrib\config.yaml
#   (edit the three EDIT ME values below)
#   Restart-Service otelcol-contrib
#
# The collector validates its config on load, so a mistake fails at
# Restart-Service rather than dropping lines quietly; the Windows Application
# event log says why. That is also where it reports a rejected push - a 401
# here is silent otherwise, and went unnoticed for hours on the old stack.
#
# The glob is k15-*.jsonl, so blind-suite runs writing test-*.jsonl never leave
# the machine. events.py moves files older than two days into logs\archive\,
# which this glob does not match: a tailed file costs CPU whether or not it can
# still change, and only today's file is ever appended to.

extensions:
  # Read offsets on disk, so a collector that was down BACKFILLS from where it
  # stopped instead of skipping to the end. Without it the shipper-death drill
  # loses everything written while the service was stopped.
  file_storage:
    directory: C:\ProgramData\otelcol-contrib\storage

receivers:
  filelog/events:
    include:
      # EDIT ME. Do not guess the path - print it on the K15 with:
      #   cd %USERPROFILE%\Desktop\slopstation\k15
      #   python -c "import events; print(events.LOG_DIR)"
      # then write it here with FORWARD slashes.
      - C:/Users/minipc/Desktop/slopstation/k15/logs/k15-*.jsonl
    start_at: beginning
    storage: file_storage
    poll_interval: 10s
    operators:
      - type: json_parser
        # One JSON object per line -> one log record's attributes. The line is
        # written by events.emit and its field names are the query surface:
        # event, lane, turn, session, level, env, service, host.
        timestamp:
          parse_from: attributes.ts
          layout_type: gotime
          # events.emit writes RFC3339 with milliseconds, always UTC. The
          # record's own time, never the moment the file was read: a shipper
          # that was down must not stamp its backlog "now".
          layout: '2006-01-02T15:04:05.000Z07:00'
        severity:
          # info / warn / error are already stanza's own names, so the default
          # mapping is exact. events.py owns that vocabulary (no debug).
          parse_from: attributes.level

      # The message Sentry lists. The event NAME, not the raw line: event names
      # are the interface dashboards group by, and every other field is an
      # attribute beside it. copy, not move - `event` has to stay queryable.
      - type: copy
        from: attributes.event
        to: body

      # Joins a log line to the span it happened inside, so clicking one opens
      # that turn's waterfall. Only the voice lane sets it (see
      # telemetry/sentry.py); the guard keeps every other line from erroring.
      - type: trace_parser
        if: 'attributes["trace"] != nil'
        trace_id:
          parse_from: attributes.trace

processors:
  resource/k15:
    attributes:
      # What separates the two machines inside one Sentry project. The `service`
      # attribute on every record says the same thing; this is the resource-level
      # copy Sentry groups by.
      - key: service.name
        value: k15
        action: upsert
  batch:
    timeout: 10s

exporters:
  otlphttp/sentry:
    # EDIT ME (both lines). Sentry project settings > Client Keys (DSN) >
    # OpenTelemetry (OTLP) prints these ready to paste. logs_endpoint, not
    # endpoint: traces reach Sentry from the voice lane's own SDK, and a
    # combined endpoint here would advertise a traces pipeline this collector
    # does not have.
    logs_endpoint: https://oORGID.ingest.us.sentry.io/api/PROJECTID/integration/otlp/v1/logs
    headers:
      x-sentry-auth: "sentry sentry_key=PUBLICKEY"
    compression: gzip
    encoding: proto
    # A dead uplink costs telemetry and nothing else: the collector retries,
    # and nothing in the voice or chord lane waits on it.
    retry_on_failure:
      enabled: true
    sending_queue:
      enabled: true
      storage: file_storage

service:
  extensions: [file_storage]
  pipelines:
    logs:
      receivers: [filelog/events]
      processors: [resource/k15, batch]
      exporters: [otlphttp/sentry]
  telemetry:
    logs:
      level: warn
