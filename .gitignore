# Claude Code local settings (personal, not shared)
.claude/settings.local.json

# Third-party binaries (VirtualHere - download, don't redistribute)
*.exe

# VirtualHere app config - contains EasyFind ID/PIN (remote-access credentials)
config.ini

# Machine-generated DisplayMagician shortcuts - recreate per guide Stage 6
*.lnk

# Runtime state and logs
logs/
state/
couch.log
couch.log.*

# Per-machine config + API credentials - commit the *.example/*.template, never
# these. Keeping them local lets a machine run straight from a git checkout and
# `git pull` for updates without tuning/keys ever fighting the merge.
secrets.json
config.json
media/.env

# The venv, the editable install's metadata, and tool caches
.venv/
*.egg-info/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Voice: wake-word model binaries. Pretrained models are fetched into the venv;
# custom models are local artifacts supplied by the operator.
src/slopstation/agent/models/*

# Voice: room recordings for wake-word training - tens of MB of the TV, and
# the gaming PC is where they are consumed, not here
room.wav
room_*.wav

# OS / editor cruft
Thumbs.db
.DS_Store
*.swp
