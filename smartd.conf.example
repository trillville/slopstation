# SMART monitoring for the K15's USB media drive.
# Copy this file and register the service from an administrator shell:
#   copy smartd.conf.example "%PROGRAMFILES%\smartmontools\bin\smartd.conf"
#   "%PROGRAMFILES%\smartmontools\bin\smartd.exe" install
#   Start-Service smartd
#
# Confirm the physical disk number after changing the drive or enclosure:
#   smartctl --scan
#
# -d sat   use SCSI/ATA translation for the USB bridge.
# -a       all attributes, health, and the error log.
# -o on    offline data collection; -S on attribute autosave.
# -s       short test daily at 02:00; long test monthly at 03:00.
# -W       temperature: log a 2 degree move, warn at 50, critical at 55. The
#          MG07's operating ceiling is 55.
# -m <nomailer> -M exec   send warnings through smart-alert.bat instead of SMTP.
#
# Add -M test for one restart to verify alerts, then remove it.
#
# Quote the script path only when it contains spaces. Use an absolute path
# because smartd runs from system32.
/dev/pd1 -d sat -a -o on -S on -s (S/../.././02|L/../01/./03) -W 2,50,55 -m <nomailer> -M exec C:\slopstation\smart-alert.bat
