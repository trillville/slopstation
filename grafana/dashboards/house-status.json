{
  "title": "Couch - house status",
  "uid": "couch-house-status",
  "description": "Is the house up, and did anything break while I was away? The one dashboard to open first. Panels are deliberately few: this answers a question, it does not survey the system.",
  "tags": ["couch", "slopstation"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Chord lane",
      "description": "Heartbeats in the last 5 minutes. 0 means the load-bearing lane is dead and the chord is deaf. Expect ~5.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service=\"k15\", lane=\"listener\", env=\"prod\"} | json | event=\"heartbeat\" [5m]))"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "DEAD",
          "mappings": [{ "type": "special", "options": { "match": "null", "result": { "text": "DEAD", "color": "red" } } }],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Voice lane",
      "description": "Heartbeats in the last 5 minutes. 0 means wake word is deaf - an overlay failure, the chord still works.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service=\"k15\", lane=\"voice\", env=\"prod\"} | json | event=\"heartbeat\" [5m]))"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "DOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errors (24h)",
      "description": "level=error across every lane. Selects on the label, so no JSON parsing.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service=\"k15\", env=\"prod\", level=\"error\"} [24h]))"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Launches (24h)",
      "description": "Sessions that reached READY. Compare with the failures panel below.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service=\"k15\", lane=\"launch\", env=\"prod\"} | json | event=\"host_ready\" [24h]))"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "fieldConfig": {
        "defaults": { "unit": "short", "noValue": "0", "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Errors and warnings over time",
      "description": "Shape matters more than height: a flat line with one spike is a discrete failure, a staircase is something retrying.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "error",
          "expr": "sum(count_over_time({service=\"k15\", env=\"prod\", level=\"error\"} [$__auto]))"
        },
        {
          "refId": "B",
          "legendFormat": "warn",
          "expr": "sum(count_over_time({service=\"k15\", env=\"prod\", level=\"warn\"} [$__auto]))"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Everything that went wrong",
      "description": "warn and error only. This is the panel you actually read; the stats above just tell you whether to bother.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 11 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"k15|gamepc\", env=\"prod\"} | json | level=~\"warn|error\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
}
