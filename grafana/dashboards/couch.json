{
  "title": "Couch",
  "uid": "couch",
  "description": "The one dashboard. Top row answers 'is it up and did anything break'; the rest answers 'how well is it working'. Deliberately one page - two dashboards means neither gets opened.",
  "tags": ["couch", "slopstation"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Chord lane",
      "description": "Heartbeats in the last 5 min. Blank/0 = the load-bearing lane is dead and the chord is deaf. Expect ~5.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        { "refId": "A", "queryType": "instant",
          "expr": "sum(count_over_time({service=\"k15\", lane=\"listener\", env=\"prod\"} | json | event=\"heartbeat\" [5m]))" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "noValue": "DEAD",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Voice lane",
      "description": "Heartbeats in the last 5 min. Blank/0 = wake word deaf. An overlay failure - the chord still works.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        { "refId": "A", "queryType": "instant",
          "expr": "sum(count_over_time({service=\"k15\", lane=\"voice\", env=\"prod\"} | json | event=\"heartbeat\" [5m]))" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "textMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "noValue": "DOWN",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Errors (24h)",
      "description": "level=error across every lane and both machines. Selects on the label, so no JSON parsing.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        { "refId": "A", "queryType": "instant",
          "expr": "sum(count_over_time({service=~\"k15|gamepc\", env=\"prod\", level=\"error\"} [24h]))" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 10 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Launches (24h)",
      "description": "Sessions that reached READY.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        { "refId": "A", "queryType": "instant",
          "expr": "sum(count_over_time({service=\"k15\", lane=\"launch\", env=\"prod\"} | json | event=\"host_ready\" [24h]))" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "0", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] }
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Time to READY - median (7d)",
      "description": "dur_ms on host_ready, measured from the chord or the wake word, not from when Enter started. This is what the couch actually experiences. Build guide measured 6-8s warm, 8-13s from sleep.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        { "refId": "A", "queryType": "instant",
          "expr": "quantile_over_time(0.5, {service=\"k15\", lane=\"launch\", env=\"prod\"} | json | event=\"host_ready\" | unwrap dur_ms [7d])" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "ms", "noValue": "no data yet" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Time to READY - p95 (7d)",
      "description": "The bad night. If this climbs past ~15s something is degrading; the milestone panel below says which stage.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 4 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        { "refId": "A", "queryType": "instant",
          "expr": "quantile_over_time(0.95, {service=\"k15\", lane=\"launch\", env=\"prod\"} | json | event=\"host_ready\" | unwrap dur_ms [7d])" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "noValue": "no data yet",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 15000 }, { "color": "red", "value": 30000 }] }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Wakes (24h)",
      "description": "Every time the wake word opened a session. Compare with the grammar hit rate to the right.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        { "refId": "A", "queryType": "instant",
          "expr": "sum(count_over_time({service=\"k15\", lane=\"voice\", env=\"prod\"} | json | event=\"wake\" [24h]))" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "noValue": "0", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Grammar hit rate (24h)",
      "description": "gate_match / (gate_match + gate_miss). How often a spoken command was handled deterministically instead of costing an LLM round trip. Low means the grammar needs phrases added; high and falling is a regression.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 4 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        { "refId": "A", "queryType": "instant",
          "expr": "sum(count_over_time({service=\"k15\", lane=\"voice\", env=\"prod\"} | json | event=\"gate_match\" [24h])) / sum(count_over_time({service=\"k15\", lane=\"voice\", env=\"prod\"} | json | event=~\"gate_match|gate_miss\" [24h]))" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1, "noValue": "no commands yet",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }, { "color": "green", "value": 0.5 }] }
        },
        "overrides": []
      }
    },

    {
      "id": 9,
      "type": "timeseries",
      "title": "Launch milestones",
      "description": "Points, not averages - at a handful of launches a day the individual values ARE the signal. ssh_up is the PC waking, enter_dispatched is sshd answering, host_ready is Enter finishing. Which line moved tells you which stage got slower.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        { "refId": "A", "legendFormat": "ssh_up",
          "expr": "max_over_time({service=\"k15\", lane=\"launch\", env=\"prod\"} | json | event=\"ssh_up\" | unwrap dur_ms [$__auto])" },
        { "refId": "B", "legendFormat": "enter_dispatched",
          "expr": "max_over_time({service=\"k15\", lane=\"launch\", env=\"prod\"} | json | event=\"enter_dispatched\" | unwrap dur_ms [$__auto])" },
        { "refId": "C", "legendFormat": "host_ready",
          "expr": "max_over_time({service=\"k15\", lane=\"launch\", env=\"prod\"} | json | event=\"host_ready\" | unwrap dur_ms [$__auto])" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "points", "pointSize": 7, "showPoints": "always", "lineWidth": 0 } },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Voice activity",
      "description": "wake opens a session; gate_match was handled by the grammar; gate_miss went to the assistant. A rising miss line is the grammar falling behind how you actually talk.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        { "refId": "A", "legendFormat": "wake",
          "expr": "sum(count_over_time({service=\"k15\", lane=\"voice\", env=\"prod\"} | json | event=\"wake\" [$__auto]))" },
        { "refId": "B", "legendFormat": "gate_match",
          "expr": "sum(count_over_time({service=\"k15\", lane=\"voice\", env=\"prod\"} | json | event=\"gate_match\" [$__auto]))" },
        { "refId": "C", "legendFormat": "gate_miss -> assistant",
          "expr": "sum(count_over_time({service=\"k15\", lane=\"voice\", env=\"prod\"} | json | event=\"gate_miss\" [$__auto]))" },
        { "refId": "D", "legendFormat": "title_miss",
          "expr": "sum(count_over_time({service=\"k15\", lane=\"voice\", env=\"prod\"} | json | event=\"title_miss\" [$__auto]))" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 0, "stacking": { "mode": "none" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "title_miss" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      }
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "Errors and warnings",
      "description": "Shape matters more than height: one spike is a discrete failure, a staircase is something retrying.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        { "refId": "A", "legendFormat": "error",
          "expr": "sum(count_over_time({service=~\"k15|gamepc\", env=\"prod\", level=\"error\"} [$__auto]))" },
        { "refId": "B", "legendFormat": "warn",
          "expr": "sum(count_over_time({service=~\"k15|gamepc\", env=\"prod\", level=\"warn\"} [$__auto]))" }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 0, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      }
    },

    {
      "id": 12,
      "type": "logs",
      "title": "Everything that went wrong",
      "description": "warn and error only, both machines. This is the panel you actually read; everything above just tells you whether to bother. Expand a line to get its turn, then query that turn for the whole story.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "grafanacloud-logs" },
      "targets": [
        { "refId": "A", "expr": "{service=~\"k15|gamepc\", env=\"prod\"} | json | level=~\"warn|error\"" }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true, "dedupStrategy": "none" }
    }
  ]
}
