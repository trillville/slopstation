# Ships the K15 JSONL event logs to Sentry over OTLP.
# Use the contrib collector because the core build lacks the filelog receiver.
# Install the MSI first, then get the service's configuration path with:
#      Get-CimInstance Win32_Service -Filter "Name='otelcol-contrib'" | % PathName
# Copy this file there as UTF-8 without a BOM, then run:
#      Restart-Service otelcol-contrib

extensions:
  # Read offsets on disk: a collector that was down backfills rather than
  # skipping to the end.
  file_storage:
    # create_directory defaults to FALSE: without it the collector refuses to
    # start when the directory is not already there.
    create_directory: true
    directory: C:\ProgramData\otelcol-contrib\storage

receivers:
  filelog/events:
    include:
      # Set this to events.LOG_DIR using forward slashes:
      #   .venv\Scripts\python -c "from slopstation import events; print(events.LOG_DIR)"
      - C:/slopstation/logs/k15-*.jsonl
    start_at: beginning
    storage: file_storage
    poll_interval: 10s
    operators:
      - type: json_parser
        timestamp:
          parse_from: attributes.ts
          layout_type: gotime
          # Preserve each event's original timestamp when backfilling.
          layout: '2006-01-02T15:04:05.000Z07:00'
        severity:
          # info/warn/error are already stanza's own names (events.py owns that
          # vocabulary, and there is no debug), so the default mapping is exact.
          parse_from: attributes.level

      # The message Sentry lists is the event NAME - what dashboards group by.
      # copy, not move: `event` has to stay queryable as an attribute.
      - type: copy
        from: attributes.event
        to: body

      # Joins a line to the span it happened inside. Only the voice lane sets
      # `trace` (telemetry/sentry.py); the guard keeps every other line from
      # erroring.
      - type: trace_parser
        if: 'attributes["trace"] != nil'
        trace_id:
          parse_from: attributes.trace

processors:
  resource/k15:
    attributes:
      # What separates the two machines inside one Sentry project.
      - key: service.name
        value: k15
        action: upsert
  batch:
    timeout: 10s

exporters:
  otlphttp/sentry:
    # EDIT ME, both lines: Sentry project settings > Client Keys (DSN) >
    # This collector exports logs only, so configure logs_endpoint.
    logs_endpoint: https://oORGID.ingest.us.sentry.io/api/PROJECTID/integration/otlp/v1/logs
    headers:
      x-sentry-auth: "sentry sentry_key=PUBLICKEY"
    compression: gzip
    encoding: proto
    # A dead uplink costs telemetry and nothing else: nothing in either lane
    # waits on this.
    retry_on_failure:
      enabled: true
    sending_queue:
      enabled: true
      storage: file_storage

service:
  extensions: [file_storage]
  pipelines:
    logs:
      receivers: [filelog/events]
      processors: [resource/k15, batch]
      exporters: [otlphttp/sentry]
  telemetry:
    logs:
      level: warn
