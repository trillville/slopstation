# OpenTelemetry Collector - gaming PC log shipper. Same MSI and the same two
# EDIT ME values as k15\otelcol\config.yaml.example, which carries the install
# notes; only the paths and the second source differ.
#
# Two streams: pc-*.jsonl is the milestones (structured, carries the turn id -
# what alerts fire on; pc-dispatch-* is the same shape from Dispatch.ps1, in
# its own file because it writes elevated), and *.log is Start-Transcript's
# narrative, shipped as free text with the turn id in the filename.
#
# Clear-OldLogs moves both out of these globs after two days, which bounds the
# backfill and the file count. Its own comment carries the per-file cost that
# sized that window.

extensions:
  file_storage:
    directory: C:\ProgramData\otelcol-contrib\storage

receivers:
  filelog/pc_events:
    include:
      - C:/CouchGaming/logs/pc-*.jsonl
    start_at: beginning
    storage: file_storage
    poll_interval: 10s
    operators:
      - type: json_parser
        timestamp:
          parse_from: attributes.ts
          # Write-CgEvent and events.emit produce the same format;
          # test_ps_parse asserts they never drift apart.
          layout_type: gotime
          layout: '2006-01-02T15:04:05.000Z07:00'
        severity:
          parse_from: attributes.level
      - type: copy
        from: attributes.event
        to: body

  filelog/pc_transcripts:
    include:
      - C:/CouchGaming/logs/*.log
    # NOT start_at: end. A transcript is written and CLOSED in about ten
    # seconds while the poll interval is 10s, so the collector would discover
    # every file already complete, seek past it and ship nothing.
    start_at: beginning
    storage: file_storage
    poll_interval: 10s
    attributes:
      # Free text, so there is nothing to parse out.
      lane: pc-transcript
      env: prod
      service: gamepc

processors:
  resource/gamepc:
    attributes:
      - key: service.name
        value: gamepc
        action: upsert
  batch:
    timeout: 10s

exporters:
  otlphttp/sentry:
    # EDIT ME, both lines - the same project as the K15, so one turn is still
    # one query across both machines.
    logs_endpoint: https://oORGID.ingest.us.sentry.io/api/PROJECTID/integration/otlp/v1/logs
    headers:
      x-sentry-auth: "sentry sentry_key=PUBLICKEY"
    compression: gzip
    encoding: proto
    retry_on_failure:
      enabled: true
    sending_queue:
      enabled: true
      storage: file_storage

service:
  extensions: [file_storage]
  pipelines:
    logs:
      receivers: [filelog/pc_events, filelog/pc_transcripts]
      processors: [resource/gamepc, batch]
      exporters: [otlphttp/sentry]
  telemetry:
    logs:
      level: warn
