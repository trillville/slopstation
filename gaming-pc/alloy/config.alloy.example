// Grafana Alloy - gaming PC log shipper. Same install and same two
// environment variables as the K15 copy (k15/alloy/config.alloy.example has
// the setup notes); only the paths and the second source differ.
//
// Two streams:
//
//   pc-YYYYMMDD.jsonl   the MILESTONES - enter_start, profile_applied,
//                       puck_claimed, ready, enter_failed, exit_done.
//                       Structured, carries the turn id; what dashboards
//                       count and alerts fire on.
//
//   enter-*.log etc.    the NARRATIVE - Start-Transcript's full capture of
//                       the run, shipped as free text under
//                       lane="pc-transcript". Filename carries the turn id.
//
// When shipping stops silently, the Windows Application event log is where
// Alloy says why - it carried the E2 401 all along, unnoticed for hours.

// OFF - see the K15 copy.
livedebugging { enabled = false }

// COST: ~0.04% of one core per TAILED FILE, whether or not that file ever
// changes. Measured 2026-08-11 by A/B on a single live process:
//
//    53 files   2.11 / 2.96 / 1.72 %   mean 2.26
//   103 files   4.29 / 5.46 / 3.28 %   mean 4.34     (+50 empty .log files)
//    53 files   back to ~2-3 %          (files removed again)
//
// +50 files = +2.08% of a core = 0.042%/file. The cost is POLLING, not
// throughput - the added files were empty - so the file count in these globs
// is what matters, and it is why Clear-OldLogs archives.
//
// MEASUREMENT TRAP: Get-Process / .TotalProcessorTime / .CPU return ZERO for
// Alloy, silently - it runs as a service under an account a non-elevated
// shell cannot read processor time from, and the API reports 0.00% rather
// than raising. Use Win32_Process (UserModeTime + KernelModeTime, 100ns
// units) sampled twice, which works unelevated:
//
//   $q="SELECT UserModeTime,KernelModeTime FROM Win32_Process WHERE Name='alloy-windows-amd64.exe'"
//   $a=Get-CimInstance -Query $q; sleep 60; $b=Get-CimInstance -Query $q
//   (($b.UserModeTime+$b.KernelModeTime-$a.UserModeTime-$a.KernelModeTime)/1e7)/60*100
//
// Do not use lifetime CPU divided by uptime: it averages in the startup file
// walk and reads high for the first half hour after a restart.
//
// Clear-OldLogs moves transcripts out of this glob after two days; archived
// files stay under logs/archive/ until the usual 30-day retention. Two days
// is sized for THE SHIPPER BEING DOWN, not for appendability (every producer
// is a Task Scheduler singleton, so at most one file per tag is ever open and
// seconds would cover that). Archive-on-close would move a file out of this
// glob before Alloy read it whenever the service is stopped or the uplink is
// rejecting writes. Shorten it only alongside an alert that catches a dead
// shipper faster than the new window.
//
// KNOWN GAP: pc-*.jsonl below is NOT archived, only deleted at 30 days, so
// that glob grows by one file per day to ~30 while only today's can ever be
// appended to - ~1.2% of a core to poll files that can never change again.
// The fix is the move Clear-OldLogs already makes for *.log.

// ---------------------------------------------------------------- milestones

local.file_match "pc_events" {
	path_targets = [{
		__path__ = "C:/CouchGaming/logs/pc-*.jsonl",
	}]
	sync_period = "30s"
}

loki.source.file "pc_events" {
	targets    = local.file_match.pc_events.targets
	forward_to = [loki.process.pc_events.receiver]
}

loki.process "pc_events" {
	stage.json {
		expressions = {
			level   = "level",
			lane    = "lane",
			env     = "env",
			service = "service",
			ts      = "ts",
		}
	}

	stage.labels {
		values = {
			level   = "",
			lane    = "",
			env     = "",
			service = "",
		}
	}

	stage.timestamp {
		source = "ts"
		format = "RFC3339"
	}

	forward_to = [loki.write.grafana_cloud.receiver]
}

// ---------------------------------------------------------------- transcripts

local.file_match "pc_transcripts" {
	path_targets = [{
		__path__ = "C:/CouchGaming/logs/*.log",
		service  = "gamepc",
		lane     = "pc-transcript",
		env      = "prod",
		level    = "info",
	}]
	sync_period = "30s"
}

loki.source.file "pc_transcripts" {
	targets    = local.file_match.pc_transcripts.targets
	forward_to = [loki.write.grafana_cloud.receiver]

	// NO tail_from_end here: a transcript is written and CLOSED in about ten
	// seconds while sync_period is 30s, so Alloy would discover every new file
	// already complete, seek to its end and ship nothing. Backfill is bounded
	// at the source instead - Clear-OldLogs moves transcripts older than two
	// days into logs\archive\, which this glob does not match.
}

// -------------------------------------------------------------------- output

loki.write "grafana_cloud" {
	endpoint {
		// Same endpoint the K15 uses.
		url = "https://logs-prod-021.grafana.net/loki/api/v1/push"

		basic_auth {
			username = sys.env("GC_LOKI_USER")   // instance id: 1730320
			password = sys.env("GC_LOKI_TOKEN")
		}
	}
}
