// Grafana Alloy - gaming PC log shipper. (docs/observability-design.md, E4)
//
// Same install and same two environment variables as the K15 copy
// (k15/alloy/config.alloy.example has the full setup notes); only the paths
// and the second source differ.
//
// This machine ships TWO streams, deliberately, because they answer different
// questions:
//
//   pc-YYYYMMDD.jsonl   the MILESTONES - enter_start, profile_applied,
//                       puck_claimed, ready, enter_failed, exit_done. Structured,
//                       carries the turn id, and is what dashboards count and
//                       alerts fire on.
//
//   enter-*.log etc.    the NARRATIVE - Start-Transcript's full capture of the
//                       run, including every line nobody thought to instrument.
//                       Shipped as free text under lane="pc-transcript". This is
//                       what you actually read when an enter fails in a NEW way,
//                       and converting it to JSON would only wrap prose in
//                       punctuation. Its filename carries the turn id too.

// OFF, and it should stay off. Two claims were made for it during bring-up
// and both were wrong: it does not cost CPU (4.44% of one core before,
// 4.53% after - no effect), and it did not help diagnose anything. The
// component pages at http://localhost:12345 - Arguments, Exports, health -
// work WITHOUT it; they are what showed file_match's resolved target. This
// feature streams data through a component and is not even implemented for
// the ones used here ("Live debugging is not yet available for this
// component"). What actually solved the E2 outage was the Windows
// Application event log, which carried the 401 all along.
livedebugging { enabled = false }

// ---------------------------------------------------------------- milestones

local.file_match "pc_events" {
	path_targets = [{
		__path__ = "C:/CouchGaming/logs/pc-*.jsonl",
	}]
	sync_period = "30s"
}

loki.source.file "pc_events" {
	targets    = local.file_match.pc_events.targets
	forward_to = [loki.process.pc_events.receiver]
}

loki.process "pc_events" {
	stage.json {
		expressions = {
			level   = "level",
			lane    = "lane",
			env     = "env",
			service = "service",
			ts      = "ts",
		}
	}

	stage.labels {
		values = {
			level   = "",
			lane    = "",
			env     = "",
			service = "",
		}
	}

	stage.timestamp {
		source = "ts"
		format = "RFC3339"
	}

	forward_to = [loki.write.grafana_cloud.receiver]
}

// ---------------------------------------------------------------- transcripts

local.file_match "pc_transcripts" {
	path_targets = [{
		__path__ = "C:/CouchGaming/logs/*.log",
		service  = "gamepc",
		lane     = "pc-transcript",
		env      = "prod",
		level    = "info",
	}]
	sync_period = "30s"
}

loki.source.file "pc_transcripts" {
	targets    = local.file_match.pc_transcripts.targets
	forward_to = [loki.write.grafana_cloud.receiver]

	// Only NEW transcript content. There are 100+ historical transcripts in
	// that folder, and unlike the JSONL stream they carry no parseable
	// timestamp - so a first run would ship months of old sessions all
	// stamped "now", burying today's launch under history that looks live.
	// The old files stay on disk; they were never the queryable surface.
	tail_from_end = true
}

// -------------------------------------------------------------------- output

loki.write "grafana_cloud" {
	endpoint {
		// This rig's real value - the same endpoint the K15 uses.
		url = "https://logs-prod-021.grafana.net/loki/api/v1/push"

		basic_auth {
			username = sys.env("GC_LOKI_USER")   // instance id: 1730320
			password = sys.env("GC_LOKI_TOKEN")
		}
	}
}
